# DocuFlow AI — copy to .env and adjust. No secrets are baked into images.

# Postgres
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=docuflow
POSTGRES_DB=docuflow

# Ollama model used for classification, field parsing and QA.
# Keep a ~3B model on 6 GB VRAM cards (RTX 3060 Laptop) so it coexists with docTR.
OLLAMA_MODEL=qwen2.5:3b

# Embedding model for the agentic RAG vector store.
OLLAMA_EMBED_MODEL=nomic-embed-text

# OCR device: "cuda" (GPU) or "cpu" (documented degraded fallback).
OCR_DEVICE=cuda

# --- Local (non-docker) backend overrides, if you run uvicorn directly ---
# DATABASE_URL=postgresql+psycopg://docuflow:docuflow@localhost:5432/docuflow
# OLLAMA_HOST=http://localhost:11434
